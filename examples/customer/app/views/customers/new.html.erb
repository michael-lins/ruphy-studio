<main>
  <small>CUSTOMERS</small>
  <h1><%= @heading %></h1>
  <p>A simple Rails form. Use Ruphino to edit a field's placeholder.</p>
  <form aria-label="Customer" onsubmit="return false">
    <label for="customer_name">Name</label>
    <input id="customer_name" name="customer[name]" type="text" placeholder="Customer full name">
    <label for="customer_email">Email</label>
    <input id="customer_email" name="customer[email]" type="email" placeholder="name@example.com!">
  </form>
</main>
